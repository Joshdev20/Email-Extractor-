# Google Places API (New) - recommended for new deployments.
# Enable Places API (New) and billing, or use a no-cost Maps Demo Key:
# https://developers.google.com/maps/documentation/places/web-service/get-api-key
# https://developers.google.com/maps/demo-key
GOOGLE_PLACES_API_KEY=

# Google Custom Search JSON API - existing customers only.
# The API is closed to new customers; new projects receive 403 access errors.
# https://developers.google.com/custom-search/v1/overview
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Optional application settings
# Serverless hosts (Vercel) set VERCEL automatically and use sync extraction.
SYNC_EXTRACTION=0
SYNC_MAX_SECONDS=55
ALLOWED_ORIGINS=*
MAX_CONCURRENT_JOBS=3
MAX_JOB_SECONDS=1800
JOB_TTL_SECONDS=900
MAX_RETAINED_JOBS=50
RATE_LIMIT_PER_MINUTE=120
EXTRACTION_RATE_LIMIT=12
CRAWL_RATE_LIMIT_SECONDS=0.75
TRUST_PROXY=0
HTTPX_TRUST_ENV=0
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
