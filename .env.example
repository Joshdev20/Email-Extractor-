# Google Custom Search JSON API
# https://developers.google.com/custom-search/v1/overview
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Google Places API (New), optional but recommended for business discovery
GOOGLE_PLACES_API_KEY=

# Optional application settings
ALLOWED_ORIGINS=*
MAX_CONCURRENT_JOBS=3
MAX_JOB_SECONDS=1800
JOB_TTL_SECONDS=900
MAX_RETAINED_JOBS=50
RATE_LIMIT_PER_MINUTE=120
EXTRACTION_RATE_LIMIT=12
CRAWL_RATE_LIMIT_SECONDS=0.75
TRUST_PROXY=0
HTTPX_TRUST_ENV=0
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
